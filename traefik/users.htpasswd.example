# Example htpasswd for the optional nginx-auth sidecar.
# The real file is gitignored; create it with:
#   htpasswd -c traefik/users.htpasswd admin
# or without the apache2-utils package:
#   printf 'admin:%s\n' "$(openssl passwd -apr1 'change-me')" > traefik/users.htpasswd
admin:$apr1$replace$with-a-real-hash
