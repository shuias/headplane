# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; never commit it.
#
# Dex static client secrets (referenced by dex/config.yaml via `secretEnv`).
DEX_HEADPLANE_CLIENT_SECRET=
DEX_HEADSCALE_CLIENT_SECRET=
#
# Dex static user password hashes (bcrypt, referenced via `hashFromEnv`).
# Generate one with:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'secret123', bcrypt.gensalt(10)).decode())"
DEX_ALICE_PASSWORD_HASH=
DEX_BOB_PASSWORD_HASH=
